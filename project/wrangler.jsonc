{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lovismind",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lovismind-auth-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "backend/migrations",
    },
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lovismind-auth-preview",
          "database_id": "0d09c223-76e4-40ec-8f55-001127442918",
          "migrations_dir": "backend/migrations",
        },
      ],
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lovismind-auth-production",
          "database_id": "f02cc88c-08ab-422c-b429-9807bd9f4fbc",
          "migrations_dir": "backend/migrations",
        },
      ],
    },
  },
}
